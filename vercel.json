{
  "headers": [
    {
      "source": "/vps-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about/team",
      "destination": "https://cap.jntugv.edu.in/about/team",
      "permanent": false
    },
    {
      "source": "/contributors",
      "destination": "https://cap.jntugv.edu.in/contributors",
      "permanent": false
    },
    {
      "source": "/team",
      "destination": "https://cap.jntugv.edu.in/about/team",
      "permanent": false
    },
    {
      "source": "/about/contributors",
      "destination": "https://cap.jntugv.edu.in/contributors",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/vps-assets/:path*",
      "destination": "http://89.116.134.182/local-assets/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 */6 * * *"
    }
  ]
}